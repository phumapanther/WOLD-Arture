# คัดลอกไฟล์นี้เป็น live.env (ไม่ถูก commit) แล้วใส่ค่าจริง
# ใช้เฉพาะตอนไลฟ์จากเกมที่ publish แล้ว (โหมด push ผ่าน Open Cloud)

# universe id ของเกม -- ไม่ใช่ place id
# หาได้ที่ create.roblox.com > เลือกเกม > Configure > ดูในลิงก์ /universes/<id> หรือหน้า Overview
ROBLOX_UNIVERSE_ID=

# API key จาก create.roblox.com > Credentials > API Keys > Create
#   Permissions: เพิ่ม universe-messaging-service แล้วติ๊ก publish และเลือกเกมนี้
#   Security: IP allowlist ใส่ 0.0.0.0/0 ถ้าไม่รู้ IP ตัวเอง
ROBLOX_API_KEY=

# คีย์ของ Euler Stream (ตัวเซ็นคำขอที่ tiktok-live-connector ใช้ต่อไลฟ์)
# ต้องมีถึงจะต่อไลฟ์ได้ -- ยิงแบบไม่มีคีย์จะถูกปฏิเสธว่า "requires a Business plan"
# สมัครฟรีที่ https://www.eulerstream.com  แพลน Community = $0 ตลอด 2,500 requests/วัน
# (การต่อไลฟ์หนึ่งครั้งใช้ไม่กี่ request ไม่ใช่ต่ออีเวนต์ จึงเหลือเฟือ)
TIKTOK_SIGN_KEY=
